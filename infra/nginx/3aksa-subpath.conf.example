# 3AKSA temporary subpath integration for MARBO3A.LY
# Review and adapt paths before production. Do not paste over the existing MARBO3A server block.
#
# Expected static layout:
#   /var/www/3aksa/3aksa/index.html
#   /var/www/3aksa/3aksa/assets/...
#
# API:
#   127.0.0.1:3101
#
# The application remains independent even though it is exposed at /3aksa/.

location = /3aksa {
    return 308 /3aksa/;
}

location ^~ /3aksa/api/ {
    proxy_pass http://127.0.0.1:3101;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Discard any client-supplied forwarding chain. Fastify trusts only loopback Nginx.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 5s;
    proxy_read_timeout 65s;
    proxy_send_timeout 65s;

    client_max_body_size 5m;
}

location ^~ /3aksa/socket.io/ {
    proxy_pass http://127.0.0.1:3101;
    proxy_http_version 1.1;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
}

location /3aksa/ {
    root /var/www/3aksa;
    try_files $uri $uri/ /3aksa/index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(self), microphone=(self), payment=(), usb=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' blob: https:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    # HSTS is host-wide, not path-scoped. Enable only after confirming MARBO3A.LY is HTTPS-only.
    # add_header Strict-Transport-Security "max-age=31536000" always;
}

location ~* ^/3aksa/assets/.*\.(?:js|css|woff2?|png|svg|webp)$ {
    root /var/www/3aksa;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
    add_header X-Content-Type-Options "nosniff" always;
}

# 3AKSA public environment template — placeholders only. Never commit real secrets.

NODE_ENV=development
APP_VERSION=0.0.0-dev

# Web / routing
VITE_PUBLIC_BASE_PATH=/3aksa/
VITE_PUBLIC_APP_URL=http://localhost:5173/3aksa
VITE_API_BASE_URL=http://localhost:3101/3aksa/api
VITE_SOCKET_URL=http://localhost:3101
VITE_SOCKET_PATH=/3aksa/socket.io

# API
API_HOST=127.0.0.1
API_PORT=3101
API_BASE_PATH=/3aksa/api
SOCKET_PATH=/3aksa/socket.io

# PostgreSQL — local/example value only
DATABASE_URL=postgresql://3aksa_app:CHANGE_ME@127.0.0.1:5432/3aksa

# Redis — all keys must remain namespaced
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=3aksa:

# Storage abstraction
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./.data/storage

# Authentication — generate strong values outside Git for real environments
SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
PASSWORD_PEPPER=CHANGE_ME_WITH_A_SEPARATE_RANDOM_SECRET

# Optional public contact/config values
ADMIN_WHATSAPP_NUMBER=0912992050
